# Copy this file to .env ON THE PRODUCTION SERVER. Do not commit the filled-in file.
# Docker Compose reads .env for substitution; a bare Navidrome binary does not.
# For a binary or systemd service, load this file into the process environment.
ND_ACMEHOST=music.example.com
ND_ACMEEMAIL=you@example.com
ND_BASEURL=https://music.example.com
# The container/service may listen on 4533 while host port 443 maps to it.
ND_PORT=4533
# DNS: Edit for your domain's zone only.
CF_API_TOKEN=replace-with-cloudflare-dns-edit-token
# Zone: Read for all zones (required for zone discovery by the DNS library).
CF_ZONE_TOKEN=replace-with-cloudflare-zone-read-token
